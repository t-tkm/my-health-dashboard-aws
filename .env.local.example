# CDK deploy 後に出力される値を記入し、.env.local にコピーして使う
# cp .env.local.example .env.local

# Cognito
VITE_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=https://health-dashboard-123456789012.auth.ap-northeast-1.amazoncognito.com

# API Gateway
VITE_API_ENDPOINT=https://xxxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com/prod
