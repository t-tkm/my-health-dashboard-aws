# CDK deploy 後に出力される値を記入し、.env.local にコピーして使う
# cp .env.local.example .env.local

# Cognito User Pool ID
# 例: ap-northeast-1_AbCdEfGhI  （"ap-northeast-1_" を含む文字列をそのまま貼る）
VITE_USER_POOL_ID=ap-northeast-1_<UserPoolId>

# Cognito App Client ID
# 例: 1a2b3c4d5e6f7g8h9i0j1k2l3m  （英数字のみ、リージョンプレフィックスなし）
VITE_USER_POOL_CLIENT_ID=<UserPoolClientId>

# Cognito Hosted UI ドメイン（HTTPS URL をそのまま貼る）
# 例: https://health-dashboard-123456789012.auth.ap-northeast-1.amazoncognito.com
VITE_COGNITO_DOMAIN=https://health-dashboard-<AccountId>.auth.ap-northeast-1.amazoncognito.com

# API Gateway エンドポイント（末尾スラッシュあり）
# 例: https://abc123def4.execute-api.ap-northeast-1.amazonaws.com/prod/
VITE_API_ENDPOINT=https://<ApiId>.execute-api.ap-northeast-1.amazonaws.com/prod/
