# cdk deploy / cdk diff 用の環境変数テンプレート
# cp env.sh.example env.sh で env.sh を作り、値を記入して使う（env.sh は .gitignore 済み）
# 使い方: ターミナルごとに `source env.sh`

# AWS 認証（SSO の場合は source 後に `aws sso login`）
export AWS_PROFILE=your-profile
export AWS_PAGER=

# Amplify が GitHub に接続するための Personal Access Token は、ここには書かない。
# Secrets Manager の health-dashboard/github-token に登録する（手順は docs/deployment.md）。
# 別の名前で登録した場合だけ設定する
# export GITHUB_TOKEN_SECRET_NAME=health-dashboard/github-token

# 独自ドメイン（任意）。未設定なら https://main.<appId>.amplifyapp.com で公開される
# 一度設定してデプロイした後は、毎回必ず設定すること
# （未設定のまま deploy すると Amplify から独自ドメイン設定が外れる）
# export CUSTOM_DOMAIN=your-subdomain.your-domain.com

# ビルド対象のリポジトリ（任意）。未設定なら git remote origin を使う
# export GITHUB_REPO_URL=https://github.com/<owner>/my-health-dashboard-aws
